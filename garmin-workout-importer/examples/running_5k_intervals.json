{
  "name": "5K Interval Training",
  "type": "running",
  "description": "5x1km at threshold pace with active recovery",
  "steps": [
    {
      "type": "warmup",
      "duration_minutes": 10,
      "target": {"type": "hr_zone", "zone": 2}
    },
    {
      "type": "repeat",
      "repetitions": 5,
      "steps": [
        {
          "type": "interval",
          "distance_meters": 1000,
          "target": {"type": "pace", "fast": "5:00", "slow": "5:15"}
        },
        {
          "type": "recovery",
          "duration_minutes": 2,
          "target": {"type": "none"}
        }
      ]
    },
    {
      "type": "cooldown",
      "duration_minutes": 10,
      "target": {"type": "hr_zone", "zone": 2}
    }
  ]
}
